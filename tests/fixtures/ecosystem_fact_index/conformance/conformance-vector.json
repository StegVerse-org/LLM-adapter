{
  "schema": "stegverse.ecosystem-fact-index-conformance/v1",
  "vector_id": "LLMA-ECOSYSTEM-FACT-INDEX-CONFORMANCE-001",
  "subject": {
    "repository": "StegVerse-org/LLM-adapter",
    "module": "llm_adapter/ecosystem_fact_index.py",
    "build_entrypoint": "llm_adapter.ecosystem_fact_index.build_index",
    "lookup_entrypoint": "llm_adapter.ecosystem_fact_index.lookup",
    "owning_existing_goal": "SHWP-ECOSYSTEM-CHAT-INFERENCE-001"
  },
  "consumers": [
    "StegVerse-Labs/.github:RT-ECOSYSTEM-CHAT-LOCAL-ANSWER-001"
  ],
  "authority_effect": "NONE",
  "rules": {
    "disposition": {
      "ANSWER": "ALLOW",
      "NOT_FOUND": "FAIL_CLOSED",
      "REFUSED": "FAIL_CLOSED"
    },
    "fail_closed_required_fields": [
      "failure_code",
      "failed_predicate",
      "required_evidence_or_repair",
      "retry_entrypoint",
      "owning_existing_goal",
      "next_attempt"
    ],
    "citation_format": "{repository}@{revision}:{path}:{line}",
    "line_semantics": "1-based line of the supplied bytes on which the matched key appears",
    "answer_evidence_class": "OBSERVED",
    "matching": "exact, case-sensitive, no whitespace stripping, no prefix or fuzzy matching",
    "expected_answers_semantics": "exact ordered list; each answer compared on key, kind and citation",
    "fixture_paths_relative_to": "this manifest directory"
  },
