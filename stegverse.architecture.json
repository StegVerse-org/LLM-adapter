{
  "$schema": "https://stegverse.org/schemas/architecture_manifest.schema.json",
  "schema_version": "1.0.0",
  "repo_id": "LLM-adapter",
  "repo_type": "adapter",
  "description": "SDK-adjacent user-LLM access adapter that lets an authorized external LLM interact with the StegVerse demo test suite, construct manifest-ready submissions, route bounded test data to the entity sandbox runner, and return governed results without granting execution authority.",
  "inherits_from": null,
  "enforcement": "strict",
  "expected_structure": {
    "README.md": {"required": true, "purpose": "Project overview and integration notes"},
    "LICENSE": {"required": true, "purpose": "Software license"},
    "pyproject.toml": {"required": true, "purpose": "Python packaging"},
    "adapter.capabilities.json": {"required": true, "purpose": "Machine-readable adapter capabilities"},
    "LLM_ADAPTER_MIRROR_HANDOFF.md": {"required": true, "purpose": "Current build handoff source of truth"},
    "llm_adapter/": {"required": true, "purpose": "Main Python package"},
    "docs/": {"required": true, "purpose": "Runtime and integration documentation"},
    "docs/LLM_COMMUNICATIONS_STACK.md": {"required": true, "purpose": "Canonical distributed LLM communications stack map and repository boundary"},
    "docs/llm-communications-stack.json": {"required": true, "purpose": "Machine-readable distributed stack component and deployment manifest"},
    "examples/": {"required": true, "purpose": "Fixture-bound examples and demo inputs"},
    "fixtures/": {"required": true, "purpose": "Governed response fixtures"},
    "scripts/": {"required": true, "purpose": "Verification and demonstration scripts"},
    "tests/": {"required": true, "purpose": "Automated verification tests"},
    ".github/workflows/": {"required": true, "purpose": "Architecture and CI workflows"}
  },
  "file_rules": {
    "naming_conventions": {
      "python_modules": "snake_case",
      "python_packages": "snake_case",
      "test_files": "test_*.py"
    },
    "forbidden_patterns": [
      ".*secret.*\\.py$",
      ".*password.*",
      ".*api_key.*\\.txt$",
      ".*private_key.*",
      "\\.env$",
      "\\.env\\..*",
      "\\.pyc$",
      "__pycache__",
      ".*\\.bak$",
      ".*\\.tmp$",
      ".*\\.swp$",
      ".*~$"
    ]
  },
  "migration_rules": {
    "review_needed_path": "review_needed/",
    "legacy_path": "legacy/",
    "auto_migrate": false,
    "require_approval": true,
    "syntax_issue_patterns": [
      ".*\\s+.*",
      ".*[^a-zA-Z0-9_\\-\\./].*",
      ".*\\.\\..*",
      ".*\\.\\.$"
    ]
  },
  "validation_hooks": {
    "ci_pull_request": true,
    "ci_push_main": true,
    "scheduled_audit": "weekly"
  },
  "integration_points": {
    "stack_id": "STEGVERSE-LLM-COMMS-STACK-v1",
    "sdk_equivalent_user_entry": "github.com/StegVerse-org/StegVerse-SDK",
    "demo_test_suite": "github.com/StegVerse-org/demo_ingest_engine",
    "entity_sandbox_runner": "github.com/StegGhost/entity-sandbox-runner",
    "governed_inference_provider": "github.com/StegVerse-Labs/governed-llm",
    "internal_collaboration_adapter": "github.com/StegVerse-Labs/hybrid-collab-bridge",
    "communications_gateway": "github.com/StegVerse-Labs/Comms-Gateway",
    "decision_engine": "github.com/StegVerse-Labs/StegCore",
    "validation_orchestrator": "github.com/GCAT-BCAT-Engine/workflows",
    "micro_node_runtime": "github.com/StegVerse-002/micro-node-runtime",
    "core_node_runtime_demo": "github.com/StegVerse-org/core-node-runtime-demo",
    "admissibility_wiki": "github.com/StegVerse-Labs/admissibility-wiki"
  }
}