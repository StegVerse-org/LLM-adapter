{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/contracts/va-claim-assistant-privacy-runtime.schema.json",
  "title": "VA Claim Assistant privacy runtime validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "observation_source",
    "privacy_runtime_commit",
    "privacy_guarded_dispatch_commit",
    "accepted_public_route_state",
    "accepted_document_route_state",
    "negative_fixture_count",
    "negative_fixture_categories",
    "raw_pii_rejected_before_classifier",
    "sanitized_context_enforced",
    "rejected_values_retained",
    "rejected_input_hashes_retained",
    "raw_documents_retained",
    "prompts_or_model_content_retained",
    "privacy_event_safe_for_custody",
    "authority_effect",
    "activation_effect",
    "custody_claimed",
    "reconstruction_claimed",
    "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "stegverse.va_claim_assistant.privacy_runtime_validation.v1"},
    "state": {"const": "PASS"},
    "observation_source": {"enum": ["LOCAL_DETERMINISTIC_VALIDATION", "GITHUB_ACTIONS_WORKFLOW"]},
    "privacy_runtime_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "privacy_guarded_dispatch_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "accepted_public_route_state": {"const": "ANSWER_READY_PENDING_TVC_AND_CUSTODY"},
    "accepted_document_route_state": {"const": "ANSWER_READY_PENDING_TVC_AND_CUSTODY"},
    "negative_fixture_count": {"type": "integer", "minimum": 9},
    "negative_fixture_categories": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "raw_pii_rejected_before_classifier": {"const": true},
    "sanitized_context_enforced": {"const": true},
    "rejected_values_retained": {"const": false},
    "rejected_input_hashes_retained": {"const": false},
    "raw_documents_retained": {"const": false},
    "prompts_or_model_content_retained": {"const": false},
    "privacy_event_safe_for_custody": {"const": true},
    "authority_effect": {"const": false},
    "activation_effect": {"const": false},
    "custody_claimed": {"const": false},
    "reconstruction_claimed": {"const": false},
    "receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
