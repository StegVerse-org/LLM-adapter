{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/contracts/chat-specialty-profile.schema.json",
  "title": "StegVerse Chat Specialty Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "specialty_id",
    "display_name",
    "purpose",
    "base_llm_profile",
    "inherits_full_llm_surface",
    "input_modalities",
    "context_policy",
    "response_behaviors",
    "candidate_tools",
    "authority_policy",
    "product_invariants"
  ],
  "properties": {
    "schema": {"const": "stegverse.chat_specialty_profile.v1"},
    "specialty_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "base_llm_profile": {"const": "ecosystem-chat-llm"},
    "inherits_full_llm_surface": {"const": true},
    "input_modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["text", "image", "file", "audio"]}
    },
    "context_policy": {"type": "object", "minProperties": 1},
    "response_behaviors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purpose", "execution_state", "execution_authority"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "execution_state": {"const": "CANDIDATE_ONLY_NOT_EXECUTED"},
          "execution_authority": {"const": false}
        }
      }
    },
    "authority_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specialty_selection_is_execution_authority",
        "model_output_is_execution_authority",
        "tool_candidate_is_execution_authority",
        "provider_runtime_is_duplicated",
        "custody_path_is_duplicated"
      ],
      "properties": {
        "specialty_selection_is_execution_authority": {"const": false},
        "model_output_is_execution_authority": {"const": false},
        "tool_candidate_is_execution_authority": {"const": false},
        "provider_runtime_is_duplicated": {"const": false},
        "custody_path_is_duplicated": {"const": false}
      }
    },
    "product_invariants": {"type": "object", "minProperties": 1}
  }
}
