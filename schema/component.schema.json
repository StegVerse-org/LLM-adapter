{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/llm-communications-stack/component.schema.json",
  "title": "StegVerse LLM Communications Stack Component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stack_id",
    "component_id",
    "repository",
    "role",
    "deployment_posture",
    "consumes",
    "produces",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stack_id": {"const": "STEGVERSE-LLM-COMMS-STACK-v1"},
    "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "role": {"type": "string", "minLength": 3},
    "version": {"type": "string", "minLength": 1},
    "deployment_posture": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["demo", "conformance", "reference_implementation", "development", "testing", "production_candidate", "production"]}
    },
    "consumes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "produces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "upstream": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "downstream": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns", "excludes"],
      "properties": {
        "owns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excludes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence_posture": {"type": "string", "minLength": 1},
    "documentation": {"type": "string", "minLength": 1}
  }
}
