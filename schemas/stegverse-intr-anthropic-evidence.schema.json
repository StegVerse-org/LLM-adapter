{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.stegverse.org/intr/stegverse-intr-anthropic-evidence.schema.json",
  "title": "StegVerse InTr Anthropic Response / Evidence / Usage / Egress",
  "description": "Companion schema set for stegverse.intr.anthropic.transport.v1. None of these artifacts confer transition standing.",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "transport_id": { "type": "string", "pattern": "^svintr-anth-[0-9a-f]{64}$" },

    "normalized_block": {
      "type": "object",
      "required": ["index", "type", "material", "block"],
      "additionalProperties": true,
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "type": { "type": "string", "minLength": 1 },
        "material": { "type": "boolean" },
        "block": {
          "type": "object",
          "description": "The provider content block retained verbatim. Nothing is discarded."
        },
        "text": { "type": "string" },
        "tool_name": { "type": "string" },
        "tool_use_id": { "type": "string" }
      }
    },

    "provider_response": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "output",
        "normalized_blocks",
        "request_hash",
        "metadata",
        "authority_effect",
        "egress_intr_required"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": { "const": "anthropic" },
        "model": { "type": "string", "minLength": 1 },
        "output": {
          "type": "string",
          "description": "Display projection: text blocks joined by newline. Never the sole hash basis."
        },
        "normalized_blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/normalized_block" }
        },
        "request_hash": { "$ref": "#/$defs/sha256" },
        "authority_effect": { "const": "NONE" },
        "egress_intr_required": { "const": true },
        "metadata": {
          "type": "object",
          "required": [
            "provider_mode",
            "response_id",
            "runtime_model",
            "transport_id",
            "ingress_receipt_hash",
            "anthropic_api_version",
            "credential_authority",
            "credential_material_present",
            "egress_intr_required",
            "authority_effect",
            "normalization_version"
          ],
          "properties": {
            "provider_mode": { "const": "anthropic_messages_intr_transport" },
            "response_id": { "type": "string", "minLength": 1 },
            "stop_reason": { "type": ["string", "null"] },
            "stop_sequence": { "type": ["string", "null"] },
            "runtime_model": { "type": "string", "minLength": 1 },
            "runtime_model_matches_admitted": { "type": "boolean" },
            "usage": { "type": "object" },
            "transport_id": { "$ref": "#/$defs/transport_id" },
            "ingress_receipt_hash": { "$ref": "#/$defs/sha256" },
            "anthropic_api_version": { "type": "string", "enum": ["2023-06-01"] },
            "credential_authority": { "const": "TV/TVC" },
            "credential_material_present": { "const": false },
            "egress_intr_required": { "const": true },
            "authority_effect": { "const": "NONE" },
            "normalization_version": { "const": "1" },
            "unknown_block_types_admitted": { "type": "boolean" },
            "output_is_lossy_projection": { "type": "boolean" }
          }
        }
      }
    },

    "transport_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "transport_id",
        "transition_id",
        "request_hash",
        "envelope_hash",
        "ingress_receipt_hash",
        "provider",
        "model",
        "response_hash",
        "egress_intr_required",
        "authority_effect",
        "credential_authority",
        "credential_material_present"
      ],
      "properties": {
        "protocol_version": { "const": "stegverse.intr.anthropic.transport.v1" },
        "transport_id": { "$ref": "#/$defs/transport_id" },
        "transition_id": { "type": "string", "minLength": 1 },
        "request_hash": { "$ref": "#/$defs/sha256" },
        "envelope_hash": { "$ref": "#/$defs/sha256" },
        "ingress_receipt_hash": { "$ref": "#/$defs/sha256" },
        "provider": { "const": "anthropic" },
        "model": { "type": "string", "minLength": 1 },
        "response_hash": { "$ref": "#/$defs/sha256" },
        "egress_intr_required": { "const": true },
        "authority_effect": { "const": "NONE" },
        "credential_authority": { "const": "TV/TVC" },
        "credential_material_present": { "const": false }
      }
    },

    "usage_event": {
      "type": "object",
      "required": [
        "protocol_version",
        "measurement_id",
        "session_id",
        "transition_id",
        "provider",
        "model",
        "interaction_type",
        "origin_entry_point",
        "metrics",
        "provider_native_usage",
        "receipt_refs",
        "authority_effect"
      ],
      "properties": {
        "measurement_id": { "type": "string", "pattern": "^meas-[0-9a-f]{64}$" },
        "session_id": { "type": "string", "minLength": 1 },
        "transition_id": { "type": "string", "minLength": 1 },
        "provider": { "const": "anthropic" },
        "interaction_type": { "const": "governed_anthropic_inference" },
        "origin_entry_point": { "const": "intr" },
        "metrics": {
          "type": "object",
          "required": ["input_units", "output_units", "metrics_complete"],
          "properties": {
            "input_units": { "type": ["integer", "null"] },
            "output_units": { "type": ["integer", "null"] },
            "total_units": { "type": ["integer", "null"] },
            "metrics_complete": { "type": "boolean" }
          }
        },
        "provider_native_usage": {
          "type": "object",
          "description": "Anthropic-native field names retained verbatim (input_tokens, output_tokens, cache_creation_input_tokens, cache_read_input_tokens, ...)."
        },
        "receipt_refs": {
          "type": "object",
          "required": ["ingress_receipt_hash", "envelope_hash", "response_hash"],
          "properties": {
            "ingress_receipt_hash": { "$ref": "#/$defs/sha256" },
            "envelope_hash": { "$ref": "#/$defs/sha256" },
            "response_hash": { "$ref": "#/$defs/sha256" }
          }
        },
        "authority_effect": { "const": "NONE" },
        "credential_material_present": { "const": false }
      }
    },

    "egress_verification": {
      "type": "object",
      "required": [
        "state",
        "transition_authority",
        "authority_effect",
        "response_hash",
        "egress_receipt_hash",
        "locally_generated_allow"
      ],
      "properties": {
        "state": { "const": "EGRESS_ADMITTED" },
        "transition_authority": { "const": "Interlock/InTr" },
        "authority_effect": { "const": "NONE_LOCAL" },
        "response_hash": { "$ref": "#/$defs/sha256" },
        "egress_receipt_hash": { "$ref": "#/$defs/sha256" },
        "decision_origin": { "const": "external_interlock_intr" },
        "locally_generated_allow": { "const": false }
      }
    }
  },

  "type": "object",
  "properties": {
    "provider_response": { "$ref": "#/$defs/provider_response" },
    "transport_evidence": { "$ref": "#/$defs/transport_evidence" },
    "usage_event": { "$ref": "#/$defs/usage_event" },
    "egress_verification": { "$ref": "#/$defs/egress_verification" }
  }
}
