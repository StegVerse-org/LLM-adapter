{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/provider_usage_event.schema.json",
  "title": "StegVerse Provider-Owned Usage Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "event_type", "provider", "request", "response", "measurements", "reasoning_provenance", "authority_boundary", "return_to_origin", "manual_user_action_required", "event_sha256"],
  "properties": {
    "schema": {"const": "stegverse.provider_usage_event.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["PROVIDER_RESPONSE", "PROVIDER_REFUSAL", "PROVIDER_ERROR"]},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "model", "model_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "request_sha256"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["response_id", "response_sha256", "status"],
      "properties": {
        "response_id": {"type": "string", "minLength": 1},
        "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["SUCCESS", "REFUSED", "ERROR"]}
      }
    },
    "measurements": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "latency_ms", "compute_units"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "integer", "minimum": 0},
        "compute_units": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "reasoning_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "reference", "full_chain_of_thought_included"],
      "properties": {
        "mode": {"const": "bounded_reference"},
        "reference": {"type": "string", "minLength": 1},
        "full_chain_of_thought_included": {"const": false}
      }
    },
    "authority_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_is_execution_authority", "provider_response_is_admissibility", "model_output_is_publication_authority", "reasoning_provenance_is_full_chain_of_thought", "usage_measurement_is_value_claim", "provider_identity_is_actor_authority"],
      "properties": {
        "adapter_is_execution_authority": {"const": false},
        "provider_response_is_admissibility": {"const": false},
        "model_output_is_publication_authority": {"const": false},
        "reasoning_provenance_is_full_chain_of_thought": {"const": false},
        "usage_measurement_is_value_claim": {"const": false},
        "provider_identity_is_actor_authority": {"const": false}
      }
    },
    "return_to_origin": {
      "type": "object", "additionalProperties": false,
      "required": ["origin_event_id", "receipt_required"],
      "properties": {
        "origin_event_id": {"type": "string", "minLength": 1},
        "receipt_required": {"const": true}
      }
    },
    "manual_user_action_required": {"const": false},
    "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
