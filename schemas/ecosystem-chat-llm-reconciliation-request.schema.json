{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/ecosystem-chat-llm-reconciliation-request.schema.json",
  "title": "StegVerse Ecosystem Chat LLM Reconciliation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workload_id", "workload_hash", "source_ids", "contribution_hashes", "governance_refs", "policy_refs", "created_at", "reconciliation_role", "authority", "reconciliation_hash"],
  "properties": {
    "schema_version": {"const": "stegverse.ecosystem_chat.llm_reconciliation_request.v1"},
    "workload_id": {"type": "string", "minLength": 1},
    "workload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "contribution_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "governance_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "policy_refs": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "minLength": 1},
    "reconciliation_role": {"const": "EVIDENCE_FOR_EXISTING_GOVERNANCE"},
    "reconciliation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creates_governance_engine", "grants_admission", "grants_execution", "grants_credentials", "grants_custody"],
      "properties": {
        "creates_governance_engine": {"const": false},
        "grants_admission": {"const": false},
        "grants_execution": {"const": false},
        "grants_credentials": {"const": false},
        "grants_custody": {"const": false}
      }
    }
  }
}
