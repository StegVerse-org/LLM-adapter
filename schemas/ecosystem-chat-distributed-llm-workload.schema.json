{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/ecosystem-chat-distributed-llm-workload.schema.json",
  "title": "StegVerse Ecosystem Chat Distributed LLM Workload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workload_id", "workload_hash", "canonical_request_id", "canonical_request_hash", "routing_mode", "sources", "purpose", "required_capabilities", "policy_refs", "governance_refs", "metadata", "created_at", "authority"],
  "properties": {
    "schema_version": {"const": "stegverse.ecosystem_chat.distributed_llm_workload.v1"},
    "workload_id": {"type": "string", "minLength": 1},
    "workload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_request_id": {"type": "string", "minLength": 1},
    "canonical_request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "routing_mode": {"enum": ["single", "parallel", "sequential", "challenge", "fallback"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "provider", "model", "capabilities", "required", "locality", "sovereignty", "metadata", "authority"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "required": {"type": "boolean"},
          "locality": {"type": "string", "minLength": 1},
          "sovereignty": {"type": "string", "minLength": 1},
          "metadata": {"type": "object"},
          "authority": {"$ref": "#/$defs/noAuthority"}
        }
      }
    },
    "purpose": {"type": "string", "minLength": 1},
    "required_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "policy_refs": {"type": "array", "items": {"type": "string"}},
    "governance_refs": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"},
    "created_at": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grants_admission", "grants_execution", "grants_credentials", "grants_custody", "grants_governance"],
      "properties": {
        "grants_admission": {"const": false},
        "grants_execution": {"const": false},
        "grants_credentials": {"const": false},
        "grants_custody": {"const": false},
        "grants_governance": {"const": false}
      }
    }
  },
  "$defs": {
    "noAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_output_authority", "route_authority", "credential_authority", "governance_authority", "custody_authority", "execution_authority"],
      "properties": {
        "model_output_authority": {"const": false},
        "route_authority": {"const": false},
        "credential_authority": {"const": false},
        "governance_authority": {"const": false},
        "custody_authority": {"const": false},
        "execution_authority": {"const": false}
      }
    }
  }
}
