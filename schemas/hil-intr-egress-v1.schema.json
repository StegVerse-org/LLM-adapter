{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/hil-intr-egress-v1.schema.json",
  "title": "HIL InTr egress Interlock envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","protocol","packet_id","operation_id","from_role","to_role",
    "payload_hash","prior_receipt_hash","source_submission_id","state",
    "created_at","secret_plaintext_present","authority_transfer",
    "transport_grants_execution_authority","envelope_hash"
  ],
  "properties": {
    "schema": {"const": "stegverse.hil.intr_egress_envelope/v1"},
    "protocol": {"const": "InTr"},
    "packet_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "from_role": {"const": "HIL_CUSTODY"},
    "to_role": {"const": "TVC_HIL_LIFECYCLE"},
    "payload_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "prior_receipt_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source_submission_id": {"type": "string", "minLength": 1},
    "state": {"const": "READY_FOR_INTERLOCK_ADMISSION"},
    "created_at": {"type": "string", "minLength": 1},
    "secret_plaintext_present": {"const": false},
    "authority_transfer": {"const": false},
    "transport_grants_execution_authority": {"const": false},
    "envelope_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
