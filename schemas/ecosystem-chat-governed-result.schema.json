{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/ecosystem-chat-governed-result.schema.json",
  "title": "StegVerse Ecosystem Chat Governed LLM Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workload_id", "workload_hash", "reconciliation_hash", "disposition", "result_text", "source_ids", "contribution_hashes", "governance_refs", "decision_refs", "provenance_refs", "evidence_refs", "created_at", "authority", "result_hash"],
  "properties": {
    "schema_version": {"const": "stegverse.ecosystem_chat.governed_llm_result.v1"},
    "workload_id": {"type": "string", "minLength": 1},
    "workload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reconciliation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "disposition": {"enum": ["ADMITTED", "DENIED", "DEFERRED"]},
    "result_text": {"type": ["string", "null"]},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "contribution_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "governance_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decision_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "minLength": 1},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_output_authority", "result_grants_transition_authority", "result_grants_route_authority", "result_grants_credential_authority", "result_grants_custody_authority", "result_grants_execution_authority"],
      "properties": {
        "model_output_authority": {"const": false},
        "result_grants_transition_authority": {"const": false},
        "result_grants_route_authority": {"const": false},
        "result_grants_credential_authority": {"const": false},
        "result_grants_custody_authority": {"const": false},
        "result_grants_execution_authority": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "ADMITTED"}}},
      "then": {"properties": {"result_text": {"type": "string", "minLength": 1}}}
    }
  ]
}
