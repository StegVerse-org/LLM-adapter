{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/hil-readiness-v1.schema.json",
  "title": "StegVerse HIL Readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness_schema_path",
    "readiness_schema_sha256",
    "state",
    "service_id",
    "runtime_contract_version",
    "primary_version",
    "primary_sha256",
    "protocol_version",
    "prompt_version",
    "prompt_sha256",
    "provenance_manifest_required",
    "provenance_manifest_schema",
    "participant_metadata_required",
    "participant_notification_supported",
    "participant_notification_scope",
    "attempt_notification_schema",
    "attempt_notification_schema_path",
    "attempt_notification_schema_sha256",
    "submission_status_supported",
    "submission_status_schema",
    "submission_status_schema_path",
    "submission_status_schema_sha256",
    "submission_status_authorization",
    "notification_max_attempts",
    "terminal_notification_delivery_states",
    "completed_recipient_addresses_retained",
    "expired_recipient_addresses_retained",
    "notification_delivery_changes_submission_outcome",
    "durable_storage",
    "tvc_authority_role",
    "tvc_decision_id",
    "tvc_policy_hash",
    "tvc_decision_receipt_sha256",
    "tvc_admissible",
    "tvc_binding_matched"
  ],
  "properties": {
    "schema_version": {"const": "HIL-READINESS-v1"},
    "readiness_schema_path": {"const": "/schemas/hil-readiness-v1.schema.json"},
    "readiness_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state": {"const": "READY"},
    "service_id": {"const": "stegverse-service-gateway"},
    "runtime_contract_version": {"const": "HIL-RTG-RUNTIME-v1"},
    "primary_version": {"const": "v1.1"},
    "primary_sha256": {"const": "a7b1c62e336b4e244ecf7fdcd10af195401f6c44328de32615b073d2a5c3c462"},
    "protocol_version": {"const": "HIL-PROTOCOL-v1.1"},
    "prompt_version": {"const": "HIL-PROMPT-v1.1"},
    "prompt_sha256": {"const": "cdff8d2266bb3eefbb6e5d28d9adc548e6c8dfc039debd72fe404f1d0249912c"},
    "provenance_manifest_required": {"const": true},
    "provenance_manifest_schema": {"const": "HIL-RESPONSE-PROVENANCE-v1.1"},
    "participant_metadata_required": {"const": false},
    "participant_notification_supported": {"const": true},
    "participant_notification_scope": {"const": "ATTEMPT_NOTIFICATION_ONLY"},
    "attempt_notification_schema": {"const": "HIL-ATTEMPT-NOTIFICATION-v1"},
    "attempt_notification_schema_path": {"const": "/schemas/hil-attempt-notification-v1.schema.json"},
    "attempt_notification_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "submission_status_supported": {"const": true},
    "submission_status_schema": {"const": "HIL-SUBMISSION-STATUS-v1"},
    "submission_status_schema_path": {"const": "/schemas/hil-submission-status-v1.schema.json"},
    "submission_status_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "submission_status_authorization": {"const": "SUBMISSION_ID_PLUS_RECEIPT_ID"},
    "notification_max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
    "terminal_notification_delivery_states": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["DELIVERED", "PARTIAL_EXPIRED", "DELIVERY_EXPIRED"]},
      "allOf": [
        {"contains": {"const": "DELIVERED"}},
        {"contains": {"const": "PARTIAL_EXPIRED"}},
        {"contains": {"const": "DELIVERY_EXPIRED"}}
      ]
    },
    "completed_recipient_addresses_retained": {"const": false},
    "expired_recipient_addresses_retained": {"const": false},
    "notification_delivery_changes_submission_outcome": {"const": false},
    "durable_storage": {"const": true},
    "tvc_authority_role": {"const": "service_gateway_intake"},
    "tvc_decision_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tvc_policy_hash": {"type": "string", "pattern": "^(sha256:)?[a-fA-F0-9]{64}$"},
    "tvc_decision_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tvc_admissible": {"const": true},
    "tvc_binding_matched": {"const": true}
  }
}
