{
  "schema_version": "STEGVERSE-LLM-COMMS-STACK-v1",
  "stack_id": "STEGVERSE-LLM-COMMS-STACK-v1",
  "name": "StegVerse LLM Communications Stack",
  "architecture": "distributed_governed_communications_stack",
  "core_rule": "Distributed operation does not imply duplicated ownership.",
  "components": [
    {
      "component_id": "stegverse-sdk",
      "repository": "StegVerse-org/StegVerse-SDK",
      "role": "direct_public_and_application_entry"
    },
    {
      "component_id": "llm-adapter",
      "repository": "StegVerse-org/LLM-adapter",
      "role": "authorized_user_llm_access_adapter",
      "primary_capabilities": [
        "sdk_equivalent_demo_test_access",
        "demo_test_suite_inspection_and_manipulation",
        "manifest_ready_test_submission_construction",
        "bounded_entity_sandbox_runner_submission",
        "governed_result_return_to_originating_llm"
      ],
      "supporting_capabilities": [
        "llm_output_normalization",
        "provider_metadata_binding",
        "adapter_receipt_generation"
      ],
      "deployment_posture": ["demo", "conformance", "reference_implementation"]
    },
    {
      "component_id": "governed-llm",
      "repository": "StegVerse-Labs/governed-llm",
      "role": "stegverse_controlled_inference_provider"
    },
    {
      "component_id": "hybrid-collab-bridge",
      "repository": "StegVerse-Labs/hybrid-collab-bridge",
      "role": "internal_multi_model_collaboration_adapter"
    },
    {
      "component_id": "comms-gateway",
      "repository": "StegVerse-Labs/Comms-Gateway",
      "role": "communication_event_normalization_and_routing"
    },
    {
      "component_id": "continuity",
      "owner": "StegID / Continuity",
      "role": "continuity_evidence_and_standing"
    },
    {
      "component_id": "stegcore",
      "repository": "StegVerse-Labs/StegCore",
      "role": "commit_time_decision_engine"
    },
    {
      "component_id": "gcat-bcat-workflows",
      "repository": "GCAT-BCAT-Engine/workflows",
      "role": "deterministic_validation_and_cross_repository_orchestration"
    },
    {
      "component_id": "demo-test-suite",
      "owner": "StegVerse-org",
      "role": "isolated_demo_test_surface"
    },
    {
      "component_id": "entity-sandbox-runner",
      "repository": "StegGhost/entity-sandbox-runner",
      "role": "bounded_adversarial_and_entity_specific_test_execution"
    },
    {
      "component_id": "master-records",
      "owner": "Master Records",
      "role": "durable_custody_replay_and_reconstruction"
    }
  ],
  "required_deployment_fields": [
    "stack_id",
    "component_id",
    "source_repository",
    "source_revision",
    "deployment_environment",
    "governance_profile",
    "authority_scope",
    "evidence_posture"
  ],
  "excluded_implicit_claims": [
    "authority_from_llm_connection",
    "production_authority_from_repository_location",
    "continuity_truth_from_adapter_output",
    "admissibility_from_model_output",
    "execution_authority_from_commitment_request",
    "publication_authority_from_private_review",
    "master_record_custody_from_local_persistence"
  ]
}