{
  "schema": "stegverse.llm_adapter.free_tier_trust_policy.v1",
  "status": "policy_boundary_only",
  "tier": "free",
  "trust_goal": "bounded_live_governed_use",
  "quota": {
    "governed_inquiries_per_day": 5,
    "trial_governed_inquiries_total": 25,
    "receipt_exports_per_day": 1,
