    "exportable_audit_packet": false
  },
  "upgrade_triggers": [
    "quota_needed",
    "longer_retention_needed",
    "private_connector_needed",
    "premium_model_needed",
    "team_workspace_needed",
    "api_access_needed",
    "custom_policy_needed"
