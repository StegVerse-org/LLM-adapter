FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    STEGVERSE_BIND_HOST=0.0.0.0 \
    STEGVERSE_NODE_ROOT=/var/lib/stegverse/portable-node

WORKDIR /app

COPY pyproject.toml README.md ./
COPY llm_adapter ./llm_adapter

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir '.[service]'

RUN useradd --create-home --uid 10001 stegverse \
    && mkdir -p /var/lib/stegverse/portable-node \
    && chown -R stegverse:stegverse /var/lib/stegverse /app

USER stegverse

VOLUME ["/var/lib/stegverse/portable-node"]
# Invocation-scoped (LLMA-DECLARED-PATH-CONFORMANCE-368, .github#98 step 6):
# the container reconstructs the node root and exits. It runs no resident
# daemon, listener, supervise loop or healthcheck; governed turns arrive as
# admitted manifests through llm_adapter.collab_ingress.
ENTRYPOINT ["python", "-m", "llm_adapter.node_bootstrap"]
CMD ["bootstrap", "--root", "/var/lib/stegverse/portable-node"]
